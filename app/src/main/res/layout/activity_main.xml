<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_felt"
    android:clipToPadding="false"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/suits"
            android:textColor="@color/gold"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.MarcaTruco.Title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:rotation="-2"
            android:text="@string/tagline"
            android:textAppearance="@style/TextAppearance.MarcaTruco.Tagline" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.MarcaTruco.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:rotation="-1.5">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/suit_top_player_one"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/suit_heart"
                    android:textAppearance="@style/TextAppearance.MarcaTruco.Suit"
                    android:textColor="@color/suit_red"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/suit_bottom_player_one"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:rotation="180"
                    android:text="@string/suit_heart"
                    android:textAppearance="@style/TextAppearance.MarcaTruco.Suit"
                    android:textColor="@color/suit_red"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/player_one_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="32dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/player_one"
                    android:textAppearance="@style/TextAppearance.MarcaTruco.PlayerName"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/player_one_current_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/initial_score"
                    android:textAppearance="@style/TextAppearance.MarcaTruco.Score"
                    android:textColor="@color/suit_red"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/player_one_title" />

                <TextView
                    android:id="@+id/goal_player_one"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/score_goal"
                    android:textAppearance="@style/TextAppearance.MarcaTruco.Caption"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/player_one_current_value" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/player_one_progress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="12"
                    app:indicatorColor="@color/suit_red"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/goal_player_one"
                    app:trackColor="@color/card_track"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp" />

                <LinearLayout
                    android:id="@+id/buttons_player_one"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/player_one_progress">

                <Button
                    android:id="@+id/button_add_one_player_one"
                    style="@style/Widget.MarcaTruco.Button.Point.Red"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/add_one" />

                <Button
                    android:id="@+id/button_add_three_player_one"
                    style="@style/Widget.MarcaTruco.Button.Point.Red"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/add_three" />

                <Button
                    android:id="@+id/button_add_six_player_one"
                    style="@style/Widget.MarcaTruco.Button.Point.Red"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/add_six" />

                <Button
                    android:id="@+id/button_add_nine_player_one"
                    style="@style/Widget.MarcaTruco.Button.Point.Red"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/add_nine" />

                <Button
                    android:id="@+id/button_add_twelve_player_one"
                    style="@style/Widget.MarcaTruco.Button.Point.Red"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/add_twelve" />

                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/versus_badge"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginVertical="-12dp"
            android:background="@drawable/bg_vs_badge"
            android:elevation="12dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:rotation="-8"
            android:text="@string/versus"
            android:textColor="@color/ink"
            android:textSize="18sp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.MarcaTruco.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:rotation="1.5">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/suit_top_player_two"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/suit_spade"
                    android:textAppearance="@style/TextAppearance.MarcaTruco.Suit"
                    android:textColor="@color/ink"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/suit_bottom_player_two"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:rotation="180"
                    android:text="@string/suit_spade"
                    android:textAppearance="@style/TextAppearance.MarcaTruco.Suit"
                    android:textColor="@color/ink"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/player_two_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="32dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/player_two"
                    android:textAppearance="@style/TextAppearance.MarcaTruco.PlayerName"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/player_two_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/initial_score"
                    android:textAppearance="@style/TextAppearance.MarcaTruco.Score"
                    android:textColor="@color/ink"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/player_two_title" />

                <TextView
                    android:id="@+id/goal_player_two"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/score_goal"
                    android:textAppearance="@style/TextAppearance.MarcaTruco.Caption"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/player_two_value" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/player_two_progress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="12"
                    app:indicatorColor="@color/ink"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/goal_player_two"
                    app:trackColor="@color/card_track"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp" />

                <LinearLayout
                    android:id="@+id/buttons_player_two"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/player_two_progress">

                <Button
                    android:id="@+id/button_add_one_player_two"
                    style="@style/Widget.MarcaTruco.Button.Point.Ink"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/add_one" />

                <Button
                    android:id="@+id/button_add_three_player_two"
                    style="@style/Widget.MarcaTruco.Button.Point.Ink"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/add_three" />

                <Button
                    android:id="@+id/button_add_six_player_two"
                    style="@style/Widget.MarcaTruco.Button.Point.Ink"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/add_six" />

                <Button
                    android:id="@+id/button_add_nine_player_two"
                    style="@style/Widget.MarcaTruco.Button.Point.Ink"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/add_nine" />

                <Button
                    android:id="@+id/button_add_twelve_player_two"
                    style="@style/Widget.MarcaTruco.Button.Point.Ink"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/add_twelve" />

                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_play_history"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/play_history" />

            <Button
                android:id="@+id/button_provide_names"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/provide_names" />
        </LinearLayout>

        <Button
            android:id="@+id/button_restart_history"
            style="@style/Widget.MarcaTruco.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/restart_history" />
    </LinearLayout>
</ScrollView>
